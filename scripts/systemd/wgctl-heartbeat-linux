#!/usr/bin/env python3
import json,subprocess,sys,urllib.request
iface=sys.argv[1]
with open('/etc/wgctl/'+iface+'.json') as f: state=json.load(f)
body=subprocess.check_output(['/usr/local/sbin/wgctl-hb-linux',iface],timeout=25)
request=urllib.request.Request(state['server'].rstrip('/')+'/v1/heartbeat',data=body,headers={'Authorization':'Bearer '+state['token'],'X-Device-Id':state['device_id'],'Content-Type':'application/json'},method='POST')
with urllib.request.urlopen(request,timeout=12) as response:
    if response.status != 200: raise SystemExit('heartbeat HTTP '+str(response.status))
